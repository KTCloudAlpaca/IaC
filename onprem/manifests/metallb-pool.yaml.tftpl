apiVersion: metallb.io/v1beta1
kind: IPAddressPool
metadata:
  name: istio-ip-pool
  namespace: metallb-system
spec:
  addresses:
%{ for a in addresses ~}
    - ${a}
%{ endfor ~}
  autoAssign: true
---
apiVersion: metallb.io/v1beta1
kind: L2Advertisement
metadata:
  name: istio-l2-adv
  namespace: metallb-system
spec:
  ipAddressPools:
    - istio-ip-pool
